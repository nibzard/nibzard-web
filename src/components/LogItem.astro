---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'log'>; currentTag?: string; maxTags?: number; }
const { entry } = Astro.props;
const date = entry.data.updated || entry.data.date;
---
<li class="log-item">
  <a class="writing-row" href={`/${entry.id}`}>
    <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })}{entry.data.updated && <span> · Updated</span>}</time>
    <div><h2>{entry.data.title}</h2>{entry.data.description && <p>{entry.data.description}</p>}</div>
    <span class="row-arrow" aria-hidden="true">↗</span>
  </a>
</li>
