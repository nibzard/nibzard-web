---
import type { CareerEntry } from '../config/career';
interface Props { entries: CareerEntry[] }
const { entries } = Astro.props;
---
<div class="career-entries">
  {entries.map(entry => <article class="career-entry">
    <p class="career-period">{entry.period}</p>
    <div>
      <h3>{entry.title}</h3>
      <p class="career-organization">{entry.organization}</p>
      <ul>{entry.details.map(detail => <li>{detail}</li>)}</ul>
      {entry.link && <a class="career-source" href={entry.link.url}>{entry.link.label} <span aria-hidden="true">↗</span></a>}
    </div>
  </article>)}
</div>
<style>
  .career-entry { display: grid; grid-template-columns: 145px minmax(0, 1fr); gap: 28px; padding: 24px 0; border-top: 1px solid var(--color-border); }
  .career-period { font-size: 13px; color: var(--color-text-muted); margin: 3px 0 0; }
  h3 { margin: 0 0 6px; font-size: 19px; line-height: 1.4; }
  .career-organization { font-size: 15px; margin: 0 0 14px; }
  ul { font-size: 15px; line-height: 1.65; margin: 0; }
  li { margin: 8px 0; }
  .career-source { display: inline-block; margin-top: 12px; font-size: 13px; }
  @media (max-width: 600px) { .career-entry { grid-template-columns: 1fr; gap: 8px; } }
  @media print {
    .career-entries, .career-entry:first-child { break-before: avoid; }
    .career-entry { grid-template-columns: 110px minmax(0, 1fr); gap: 20px; padding: 12px 0; break-inside: avoid; }
    .career-period, .career-organization, .career-source, ul { font-size: 9pt; }
    h3 { font-size: 11pt; break-after: avoid; }
    .career-organization { break-after: avoid; }
    li { margin: 4px 0; break-inside: avoid; }
  }
</style>
