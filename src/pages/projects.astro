---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, featuredProjects } from '../utils/projects';
---
<BaseLayout title="Projects — nibzard" description="Tools, experiments, and open source projects by Nikola Balić." fullWidth={true}>
  <header class="page-header"><h1>Projects</h1><p>Small tools for specific problems. Built, tested, and shared.</p></header>
  {featuredProjects.map(project => <section class:list={['featured-project', { 'without-image': !project.image && !project.example }]} aria-label={`Featured project: ${project.title}`}>
    <div>{project.attribution && <p class="project-attribution">{project.attribution}</p>}<h2>{project.title}</h2><p>{project.description}</p><div class="hero-links">
      {project.article && <a href={project.article}>Read the experiment ↗</a>}<a href={project.url}>View the source ↗</a>
    </div></div>
    {project.example && <pre class="project-example"><code>{project.example}</code></pre>}
    {project.image && <a href={project.article || project.url}><img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} /></a>}
  </section>)}
  <section><div class="section-heading"><h2>Project directory</h2><a href="https://github.com/nibzard">GitHub ↗</a></div>
    {projects.length ? <ul class="project-directory">{projects.map(project => <li><h3><a href={project.url}>{project.title} ↗</a></h3><div>
      {project.description && <p>{project.description}</p>}
      <div class="project-topics">{project.attribution && <span>{project.attribution}</span>}{project.language && <span>{project.language}</span>}{project.topics.filter(topic => topic.toLowerCase() !== project.language?.toLowerCase()).map(topic => <span>{topic}</span>)}{project.archived && <span>Archived</span>}</div>
    </div></li>)}</ul> : <p>New projects are on the way. You can also browse my work on <a href="https://github.com/nibzard">GitHub</a>.</p>}
  </section>
</BaseLayout>
<style>
  .without-image { grid-template-columns: 1fr; max-width: 65ch; }
</style>
