---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerEntries from '../components/CareerEntries.astro';
import { profile, experience, advisory, teaching, education, programs, publications, software } from '../config/career';
const sections = [
  ['experience', 'Experience'], ['advisory', 'Advisory'], ['teaching', 'Teaching'],
  ['education', 'Education'], ['programs', 'Programs'], ['publications', 'Publications'],
  ['software', 'Software'], ['speaking', 'Speaking'],
];
const updated = new Date(`${profile.updated}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="Curriculum vitae — Nikola Balić" description="Nikola Balić’s professional record: developer tools, growth, university leadership, teaching, research, and open-source software.">
  <article class="career-document">
    <header class="career-header">
      <p class="document-label">Curriculum vitae</p>
      <h1>{profile.name}</h1>
      <p class="career-summary">Developer tools and growth. Research, teaching, and technology transfer.</p>
      <p class="career-location">{profile.location} · {profile.currentRole}, {profile.employer.name}</p>
      <div class="contact-links"><a href={`mailto:${profile.email}`}>{profile.email}</a>{profile.links.map(link => <a href={link.url} rel="me">{link.label}</a>)}</div>
      <div class="document-actions">
        <button id="print-cv" hidden>Print / save PDF</button>
        <a href="/about">About me <span aria-hidden="true">↗</span></a>
        <span>Updated <time datetime={profile.updated}>{updated}</time></span>
      </div>
    </header>
    <nav class="career-index" aria-label="Curriculum vitae sections">{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
    <section id="experience" aria-labelledby="experience-heading"><h2 id="experience-heading">Professional experience</h2><CareerEntries entries={experience} /></section>
    <section id="advisory" aria-labelledby="advisory-heading"><h2 id="advisory-heading">Advisory and service</h2><CareerEntries entries={advisory} /></section>
    <section id="teaching" aria-labelledby="teaching-heading"><h2 id="teaching-heading">Teaching</h2><CareerEntries entries={teaching} /></section>
    <section id="education" aria-labelledby="education-heading"><h2 id="education-heading">Education and research</h2><CareerEntries entries={education} /></section>
    <section id="programs" aria-labelledby="programs-heading">
      <h2 id="programs-heading">Research and innovation programs</h2>
      <p class="section-note">University projects and responsibilities, alongside the TTAdria work listed above.</p>
      <dl class="program-list">{programs.map(program => <div><dt>{program.name}<span>{program.period}</span></dt><dd>{program.detail}</dd></div>)}</dl>
    </section>
    <section id="publications" aria-labelledby="publications-heading">
      <h2 id="publications-heading">Publications and reports</h2>
      <p class="section-note">Journal articles, preprints, and institutional reports. Each title links to the publication.</p>
      <ol class="publication-list">{publications.map(publication => <li>
        <p class="publication-type">{publication.year} · {publication.kind}</p>
        <h3><a href={publication.url}>{publication.title}</a></h3>
        <p>{publication.authors}</p><p class="publication-venue">{publication.venue}</p>
      </li>)}</ol>
      <div class="research-links">{profile.researchLinks.map(link => <a href={link.url} rel="me">{link.label}</a>)}</div>
    </section>
    <section id="software" aria-labelledby="software-heading">
      <h2 id="software-heading">Selected open-source software</h2>
      <dl class="software-list">{software.map(project => <div><dt><a href={project.url}>{project.name}</a></dt><dd>{project.detail}</dd></div>)}</dl>
      <p class="section-note"><a href="/projects">Browse the project directory <span aria-hidden="true">↗</span></a></p>
    </section>
    <section id="speaking" aria-labelledby="speaking-heading">
      <h2 id="speaking-heading">Speaking</h2>
      <div class="talk-entry"><p class="publication-type">May 2025 · O’Reilly AI Codecon</p><h3><a href="https://www.oreilly.com/videos/ai-codecon-coding/0642572017171/0642572017171-video386929/">Designing Intelligent AI for Autonomous Action</a></h3></div>
    </section>
    <section aria-labelledby="languages-heading"><h2 id="languages-heading">Languages</h2><p>English and Croatian.</p></section>
  </article>
</BaseLayout>
<script>
  const printButton = document.querySelector<HTMLButtonElement>('#print-cv');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
</script>
<style>
  .document-label { color: var(--color-text-muted); font-size: 13px; margin-bottom: 18px; }
  .career-header h1 { margin-bottom: 18px; }
  .career-summary { font-size: 20px; max-width: 46ch; line-height: 1.5; }
  .career-location { color: var(--color-text-muted); font-size: 14px; margin-bottom: 14px; }
  .document-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 24px; margin-top: 26px; font-size: 13px; }
  .document-actions span { color: var(--color-text-muted); }
  .document-actions > span { margin-left: auto; }
  .career-index { display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 30px 0 46px; padding: 18px 0; border-block: 1px solid var(--color-border); font-size: 13px; }
  .career-index a { color: var(--color-text-muted); text-decoration: none; }
  .career-index a:hover { color: var(--color-accent1); text-decoration: underline; }
  .career-document section { margin-top: 46px; scroll-margin-top: 24px; }
  .career-document section h2 { font-size: 25px; margin: 0 0 22px; }
  .section-note { color: var(--color-text-muted); font-size: 14px; }
  .program-list, .software-list { margin: 0 0 20px; }
  .program-list > div, .software-list > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 28px; border-top: 1px solid var(--color-border); padding: 18px 0; font-size: 15px; }
  dt span { display: block; font-size: 13px; color: var(--color-text-muted); margin-top: 6px; }
  dd { margin: 0; }
  .publication-list { list-style: none; padding: 0; margin: 0; }
  .publication-list li { padding: 22px 0; margin: 0; border-top: 1px solid var(--color-border); }
  .publication-list h3, .talk-entry h3 { font-size: 18px; line-height: 1.45; margin: 0 0 10px; }
  .publication-list h3 a, .talk-entry h3 a { text-decoration: none; }
  .publication-list h3 a:hover, .talk-entry h3 a:hover { text-decoration: underline; }
  .publication-list p { font-size: 13px; margin-bottom: 5px; }
  .publication-type, .publication-venue { color: var(--color-text-muted); }
  .publication-type { font-size: 13px; }
  .research-links { display: flex; flex-wrap: wrap; gap: 20px; font-size: 13px; margin: 16px 0; }
  .talk-entry { padding: 22px 0; border-top: 1px solid var(--color-border); }
  @media (max-width: 600px) {
    .document-actions > span { width: 100%; margin-left: 0; }
    .program-list > div, .software-list > div { grid-template-columns: 1fr; gap: 8px; }
  }
  @media print {
    @page { size: A4; margin: 16mm; }
    :global(html[data-theme]) { --font-body: Arial, sans-serif; --font-heading: Arial, sans-serif; color-scheme: light; background: white; --color-background: white; --color-text: #191919; --color-text-heading: #191919; --color-text-muted: #505050; --color-accent1: #191919; --color-border: #ccc; }
    :global(body) { background: white; color: #191919; font-size: 10pt; }
    :global(.site-shell), :global(.site-body) { display: block; min-height: 0; }
    :global(.site-header), :global(.site-footer), :global(.skip-link), .document-actions, .career-index { display: none !important; }
    :global(.content-container) { padding: 0; }
    :global(.inner-container) { max-width: none; }
    :global(a) { color: #191919; text-decoration: none; }
    .career-header h1 { font-size: 26pt; margin-bottom: 10px; }
    .career-summary { font-size: 12pt; margin-bottom: 10px; }
    .career-location, .document-label, :global(.contact-links) { font-size: 9pt; }
    .career-document section { margin-top: 24px; }
    .career-document section h2 { font-size: 15pt; margin-bottom: 12px; break-after: avoid; }
    .publication-list li, .program-list > div, .software-list > div, .talk-entry { break-inside: avoid; padding: 10px 0; }
    .program-list > div, .software-list > div { grid-template-columns: 1fr 1.5fr; font-size: 9pt; }
    .publication-list h3, .talk-entry h3 { font-size: 10pt; }
    .publication-list p, .section-note, .research-links, dt span { font-size: 9pt; }
    p { orphans: 3; widows: 3; }
  }
</style>
