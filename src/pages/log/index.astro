---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import LogItem from '../../components/LogItem.astro';

// Get all log entries that aren't drafts and aren't CLAUDE.md
const logEntries = await getCollection('log', ({ data, id }) => {
  return data.draft !== true && id !== 'claude' && data.title;
});

// Sort entries by date (newest first)
logEntries.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---
<BaseLayout title="Writing - nibzard" description="A collection of thoughts, updates, and project logs.">

    <section class="log-header">
      <h1>Writing</h1>
      <p>Experiments, useful tools, and what I learn from building them.</p>
    </section>


  <ul class="log-list">
    {logEntries.length === 0 && <p>No log entries yet. Stay tuned!</p>}
    {logEntries.map((entry, index) => (

        <LogItem entry={entry} />

    ))}
  </ul>
</BaseLayout>
