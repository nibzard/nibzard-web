---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSubscribe from '../components/NewsletterSubscribe.astro';
---
<BaseLayout title="Design system — nibzard">
  <header class="page-header"><h1>Design system</h1><p>The shared language for tools, notes, and longer reads.</p></header>
  <section><h2>Typography</h2><p>Saans carries headings and prose. Saans Mono appears in code and technical details.</p><h3>A clear thought, plainly stated</h3><p>Use <strong>strong text</strong> for emphasis, <em>italic text</em> for a change of voice, and <a href="/log">descriptive links</a> for navigation.</p></section>
  <section><h2>Color</h2><div class="palette-grid">{[['Canvas','--color-background'],['Text','--color-text'],['Violet','--color-accent1'],['Lime','--color-signal']].map(([label,token]) => <div><div class="palette-swatch" style={`background:var(${token})`}></div><p>{label}<br/><code>{token}</code></p></div>)}</div></section>
  <section><h2>Controls</h2><div class="hero-links"><a class="button-primary" href="/log">Explore the writing</a><a href="/projects">See my projects ↗</a></div></section>
  <section class="log-content"><h2>Reading</h2><blockquote><p>A useful explanation begins with a concrete example.</p></blockquote><pre><code>const result = await experiment.run();
console.log(result);</code></pre><table><thead><tr><th>Element</th><th>Purpose</th></tr></thead><tbody><tr><td>Article row</td><td>Scan the archive</td></tr><tr><td>Project specimen</td><td>See the work behind a story</td></tr></tbody></table></section>
  <NewsletterSubscribe />
</BaseLayout>
