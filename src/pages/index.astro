---
import LogItem from '../components/LogItem.astro';
import { featuredProjects, homepageProjects } from '../utils/projects';
const featuredProject = featuredProjects[0];

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ThoughtRenderer from '../components/ThoughtRenderer.astro';
import NowItemRenderer from '../components/NowItemRenderer.astro';
import ImageRenderer from '../components/ImageRenderer.astro';
import IdeaRenderer from '../components/IdeaRenderer.astro';
import NewsletterSubscribe from '../components/NewsletterSubscribe.astro';
import { createInterleavedFeed, paginateFeed } from '../utils/contentFeed';
// import '../styles/index.css';

// Get current page and page size
const { searchParams } = Astro.url;
const parsedPage = Number(searchParams.get('page') || '1');
const currentPage = Number.isSafeInteger(parsedPage) && parsedPage > 0 ? parsedPage : 1;
const showFeed = searchParams.has('page');
const pageSize = 10; // Number of entries per page

// Get all log entries that aren't drafts and aren't CLAUDE.md
const logEntries = await getCollection('log', ({ data, id }) => {
  return data.draft !== true && id !== 'claude' && data.title;
});

// Sort entries: featured first, then by date (newest first)
logEntries.sort((a, b) => {
  // Featured articles always come first
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;

  // If both featured or both not featured, sort by date
  const aDate = a.data.updated || a.data.date;
  const bDate = b.data.updated || b.data.date;
  return new Date(bDate).valueOf() - new Date(aDate).valueOf();
});

// Get all thoughts that aren't drafts
const thoughts = await getCollection('thoughts', ({ data }) => {
  return data.draft !== true;
});

// Sort thoughts by date (newest first)
thoughts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Get all now entries that aren't drafts
const nowEntries = await getCollection('now', ({ data }) => {
  return data.draft !== true;
});

// Sort now entries by date (newest first)
nowEntries.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Get all image entries that aren't drafts
const imageEntries = await getCollection('images', ({ data }) => {
  return data.draft !== true;
});

// Sort image entries by date (newest first)
imageEntries.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Get all idea entries that aren't drafts
const ideaEntries = await getCollection('idea', ({ data }) => {
  return data.draft !== true;
});

// Sort idea entries by date (newest first)
ideaEntries.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Create interleaved feed with all types using utility function
const allFeedEntries = createInterleavedFeed(
  logEntries,
  thoughts,
  nowEntries,
  imageEntries,
  ideaEntries
);

// Paginate the feed entries using utility function
const { paginatedEntries: feedEntries, totalPages } = paginateFeed(
  allFeedEntries,
  currentPage,
  pageSize
);

// Build truncated pagination items: first 3, ellipsis, last 2, ±1 around current
const paginationItems: (number | string)[] = totalPages > 1
  ? Array.from({ length: totalPages }, (_, i) => i + 1).reduce(
      (acc: (number | string)[], page: number) => {
        const showPage = page <= 3 || page > totalPages - 2 || Math.abs(page - currentPage) <= 1;
        if (showPage) {
          acc.push(page);
        } else if (acc[acc.length - 1] !== '...') {
          acc.push('...');
        }
        return acc;
      },
      []
    )
  : [];

const selectedIds = [logEntries[0]?.id, 'orchestration-era', 'agentprobe'];
const selectedEntries = [...new Set(selectedIds)].map(id => logEntries.find(entry => entry.id === id)).filter(Boolean);
---
<BaseLayout title="Nikola Balić — Tools for agents. Notes for humans." description="I build AI systems and write about what I learn. Experiments, useful tools, and the details that make them work." fullWidth={true}>
  {!showFeed ? <>
    <div class="intro-note"><span>A working collection of tools and ideas.</span><span class="mono">Build → test → write</span></div>
    <section class="workbench-hero" aria-labelledby="intro-heading">
      <div><h1 id="intro-heading">Tools for agents.<br />Notes for humans.</h1>
        <p>I build AI systems and write about what I learn. Experiments, useful tools, and the details that make them work.</p>
        <div class="hero-links"><a class="button-primary" href="#writing">Explore the writing ↓</a><a href="/projects">See my projects ↗</a></div>
      </div>
      {featuredProject && <figure class="project-specimen">
        <div class="specimen-heading"><strong>Inside {featuredProject.title}</strong><span>{featuredProject.attribution || 'Featured project'}</span></div>
        {featuredProject.image && <a href={featuredProject.article || featuredProject.url}><img src={featuredProject.image.src} width={featuredProject.image.width} height={featuredProject.image.height} alt={featuredProject.image.alt} fetchpriority="high" /></a>}
        {featuredProject.example && <pre class="project-example"><code>{featuredProject.example}</code></pre>}
        <figcaption>{featuredProject.description}<a href={featuredProject.article || featuredProject.url}>{featuredProject.article ? 'Read the experiment' : 'View the source'} ↗</a></figcaption>
      </figure>}
    </section>
    <section id="writing"><div class="section-heading"><h2>Selected writing</h2><a href="/log">Browse the archive ↗</a></div>
      <ul class="log-list">{selectedEntries.map(entry => entry && <LogItem entry={entry} />)}</ul>
    </section>
    <div class="home-secondary">
      <section><h2>Small tools. Specific problems.</h2>
        {homepageProjects.map(project => <a class="small-project" href={project.url}><strong>{project.title} ↗</strong><span>{project.description}</span></a>)}
      </section>
      <section><h2>An ongoing practice</h2><p>Building, testing, and writing in public. My now page keeps track of what has my attention.</p><a href="/now">See what I’m working on ↗</a><p><a href="/?page=1">Browse all activity ↗</a></p></section>
    </div>
  </> : <>
    <header class="page-header"><a href="/">← Overview</a><h1>All activity</h1><p>Articles, thoughts, images, ideas, and updates.</p></header>
    <div class="activity-feed">
      {feedEntries.map(item => <div class="activity-item">
        {item.type === 'log' ? <ul class="log-list"><LogItem entry={item.entry as any} /></ul>
          : item.type === 'thought' ? <ThoughtRenderer entry={item.entry} />
          : item.type === 'now' ? <NowItemRenderer entry={item.entry} />
          : item.type === 'image' ? <ImageRenderer entry={item.entry} />
          : <IdeaRenderer entry={item.entry} />}
      </div>)}
      {!feedEntries.length && <p>No entries on this page. <a href="/?page=1">Return to the first page.</a></p>}
    </div>
    <nav class="pagination" aria-label="Activity pages">
      {currentPage > 1 && <a href={`/?page=${currentPage - 1}`} aria-label="Previous page">←</a>}
      {paginationItems.map(item => typeof item === 'string' ? <span>…</span> : <a href={`/?page=${item}`} aria-current={item === currentPage ? 'page' : undefined}>{item}</a>)}
      {currentPage < totalPages && <a href={`/?page=${currentPage + 1}`} aria-label="Next page">→</a>}
    </nav>
  </>}
  <NewsletterSubscribe />
</BaseLayout>
