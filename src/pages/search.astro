---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import SearchResults from '../components/SearchResults.jsx';

const { searchParams } = Astro.url;
const initialQuery = searchParams.get('q') || '';

const logEntries = await getCollection('log', ({ data, id }) => data.draft !== true && id !== 'claude' && data.title);
const thoughts = await getCollection('thoughts', ({ data }) => data.draft !== true);
const nowEntries = await getCollection('now', ({ data }) => data.draft !== true);
const ideas = await getCollection('idea', ({ data }) => data.draft !== true);
const imageEntries = await getCollection('images', ({ data }) => data.draft !== true);

// Define helper functions s and a in the frontmatter scope as well
const s = (val: any, def = '') => (val === null || typeof val === 'undefined') ? def : String(val);
const a = (val: any, def = []) => Array.isArray(val) ? val : def;

const clientFeedEntries = [
  ...ideas.map(entry => ({ type: 'idea', href: `/idea/${entry.id}`, title: entry.data.title, text: entry.data.subtitle || '', date: entry.data.date.toISOString() })),
  ...logEntries.map(entry => ({
    type: 'log',
    href: s(`/${entry.id}`),
    date: entry.data.date.toISOString(),
    title: s(entry.data.title),
    tldr: s(entry.data.tldr),
    tags: a(entry.data.tags),
  })),
  ...thoughts.map(entry => ({
    type: 'thought',
    href: s(`/thoughts/${entry.id}`),
    date: entry.data.date.toISOString(),
    text: s(entry.body?.replace(/[#*_>`]/g, '').slice(0, 240)),
    tags: a((entry.data as any)?.tags),
  })),
  ...nowEntries.map(entry => ({
    type: 'now',
    href: s(`/now/${entry.id}`),
    date: entry.data.date.toISOString(),
    title: s((entry.data as any)?.title),
    text: s(entry.body?.replace(/[#*_>`]/g, '').slice(0, 240)),
    tags: a((entry.data as any)?.tags),
  })),
  ...imageEntries.map(entry => ({
    type: 'image',
    href: s(`/images/${entry.id}`),
    date: entry.data.date.toISOString(),
    caption: s(entry.body?.replace(/[#*_>`]/g, '').slice(0, 180)),
    imageUrl: s(entry.data.imageUrl),
    tags: a((entry.data as any)?.tags),
  })),
];

---

<BaseLayout title={`Search Results for "${initialQuery}" | nibzard`} description={`Search results for "${initialQuery}" on nibzard.`}>
  <div class="search-page-container">
    <header class="page-header"><h1>Search</h1><p>Find an article, thought, or experiment.</p></header>
    <form class="search-form" action="/search" method="get"><label class="sr-only" for="site-query">Search the site</label><input id="site-query" type="search" name="q" value={initialQuery} placeholder="Search tools, topics, and ideas" /><button type="submit">Search</button></form>

    <SearchResults feedEntries={clientFeedEntries} initialQuery={initialQuery} client:load />
  </div>
</BaseLayout>
